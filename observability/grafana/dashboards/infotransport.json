{
  "uid": "infotransport",
  "title": "InfoTransport — Technique & quotas API",
  "description": "CPU et RAM du processus Node.js, métriques HTTP et compteurs locaux PRIM sur 24 h glissantes. Aucun appel fournisseur au scrape.",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["infotransport", "prometheus"],
  "timezone": "Europe/Paris",
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "api",
        "label": "API PRIM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(infotransport_prim_quota_limit{job=\"infotransport\"}, api)",
          "refId": "api"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilité de la collecte",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"infotransport\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "1 = Prometheus joint /metrics ; 0 = collecte indisponible."
    },
    {
      "id": 2,
      "title": "Temps de fonctionnement",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=\"infotransport\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "CPU du processus",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(process_cpu_seconds_total{job=\"infotransport\"}[$__rate_interval])",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "100 % correspond à un cœur CPU utilisé. Mesure du processus Node.js."
    },
    {
      "id": 4,
      "title": "RAM du processus (RSS)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"infotransport\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "CPU dans le temps",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(process_cpu_seconds_total{job=\"infotransport\"}[$__rate_interval])",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Mémoire Node.js",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"infotransport\"}",
          "legendFormat": "RSS",
          "range": true
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_used_bytes{job=\"infotransport\"}",
          "legendFormat": "Heap utilisé",
          "range": true
        },
        {
          "refId": "C",
          "expr": "nodejs_heap_size_total_bytes{job=\"infotransport\"}",
          "legendFormat": "Heap alloué",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Débit HTTP par route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(infotransport_http_requests_total{job=\"infotransport\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Les scrapes /metrics sont exclus. Les fichiers statiques et routes inconnues sont regroupés sous other."
    },
    {
      "id": 8,
      "title": "Réponses HTTP par statut",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(infotransport_http_requests_total{job=\"infotransport\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Latence HTTP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(infotransport_http_request_duration_seconds_bucket{job=\"infotransport\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(infotransport_http_request_duration_seconds_bucket{job=\"infotransport\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(infotransport_http_request_duration_seconds_bucket{job=\"infotransport\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Erreurs HTTP (4xx et 5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(infotransport_http_requests_total{job=\"infotransport\",status_code=~\"4..|5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(infotransport_http_requests_total{job=\"infotransport\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Erreurs",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Inclut les connexions interrompues (499)."
    },
    {
      "id": 11,
      "title": "Requêtes HTTP en cours",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infotransport_http_requests_in_flight{job=\"infotransport\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Retard de la boucle événementielle",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"infotransport\"}",
          "legendFormat": "p99",
          "range": true
        },
        {
          "refId": "B",
          "expr": "nodejs_eventloop_lag_mean_seconds{job=\"infotransport\"}",
          "legendFormat": "Moyenne",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Quota PRIM consommé — 24 h glissantes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * infotransport_prim_quota_used{job=\"infotransport\",api=~\"$api\"} / infotransport_prim_quota_limit{job=\"infotransport\",api=~\"$api\"}",
          "legendFormat": "{{api}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Réservations locales persistées, échecs compris. Les appels réalisés ailleurs avec la même clé ne sont pas connus."
    },
    {
      "id": 14,
      "title": "Budget automatique consommé — 24 h glissantes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * infotransport_prim_quota_automatic_used{job=\"infotransport\",api=~\"$api\"} / infotransport_prim_quota_automatic_limit{job=\"infotransport\",api=~\"$api\"}",
          "legendFormat": "{{api}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "Appels PRIM utilisés et limites",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infotransport_prim_quota_used{job=\"infotransport\",api=~\"$api\"}",
          "legendFormat": "{{api}} · utilisés",
          "range": true
        },
        {
          "refId": "B",
          "expr": "infotransport_prim_quota_limit{job=\"infotransport\",api=~\"$api\"}",
          "legendFormat": "{{api}} · limite totale",
          "range": true
        },
        {
          "refId": "C",
          "expr": "infotransport_prim_quota_automatic_used{job=\"infotransport\",api=~\"$api\"}",
          "legendFormat": "{{api}} · automatiques",
          "range": true
        },
        {
          "refId": "D",
          "expr": "infotransport_prim_quota_automatic_limit{job=\"infotransport\",api=~\"$api\"}",
          "legendFormat": "{{api}} · limite automatique",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "title": "Appels PRIM restants",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_INFOTRANSPORT_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(infotransport_prim_quota_limit{job=\"infotransport\",api=~\"$api\"} - infotransport_prim_quota_used{job=\"infotransport\",api=~\"$api\"}, 0)",
          "legendFormat": "{{api}} · total",
          "range": true
        },
        {
          "refId": "B",
          "expr": "clamp_min(infotransport_prim_quota_automatic_limit{job=\"infotransport\",api=~\"$api\"} - infotransport_prim_quota_automatic_used{job=\"infotransport\",api=~\"$api\"}, 0)",
          "legendFormat": "{{api}} · automatique",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "La collecte automatique est aussi bloquée lorsque le quota total est atteint."
    }
  ],
  "__inputs": [
    {
      "name": "DS_INFOTRANSPORT_PROMETHEUS",
      "label": "Prometheus InfoTransport",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}

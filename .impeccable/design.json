      "html": "<label class=\"ds-field\"><span id=\"ds-travel-label\">Temps pour rejoindre la gare</span><input type=\"number\" value=\"8\" aria-labelledby=\"ds-travel-label\" aria-describedby=\"ds-travel-help\"><span class=\"ds-field-help\" id=\"ds-travel-help\">Les départs à moins de 8 minutes restent affichés, mais sont atténués.</span></label>",
      "css": ".ds-field{font-family:'Manrope Variable',sans-serif;display:flex;flex-direction:column;gap:8px;color:#465448;font-size:12px;line-height:1.5}.ds-field input{font:inherit;font-size:12px;min-height:40px;padding:11px 12px;border:1px solid #cbd2c7;border-radius:4px;background:#fffefa;color:#24352a;caret-color:var(--accent,#b94c23)}.ds-field input:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}.ds-field-help{font-size:11px;font-weight:400;line-height:1.7;color:var(--muted,#626d6a)}"

      "css": ".ds-card{font-family:'Manrope Variable',sans-serif;background:#fbfaf7;border:1px solid var(--line,#d9ded7);border-radius:8px;padding:24px;color:#202a2b}.ds-card h3{font-size:16px;font-weight:700;margin:0}.ds-card p{font-size:11px;color:var(--muted,#626d6a);margin:5px 0 0}"

  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action de sauvegarde.",
      "html": "<button class=\"ds-primary\">Enregistrer</button>",
      "css": ".ds-primary{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;font-size:12px;font-weight:650;border-radius:5px;cursor:pointer;background:#284c39;color:#fff;border:1px solid #284c39}.ds-primary:hover:not(:disabled){background:#1a3728}.ds-primary:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color .15s ease,color .15s ease,border-color .15s ease}}"
    },
    {
      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Action complémentaire.",
      "html": "<button class=\"ds-secondary\">Prévisualiser</button>",
      "css": ".ds-secondary{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;font-size:12px;font-weight:650;border-radius:5px;cursor:pointer;background:transparent;color:#26392e;border:1px solid #bbc8bb}.ds-secondary:hover:not(:disabled){background:#e6e9e0}.ds-secondary:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}.ds-secondary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:no-preference){.ds-secondary{transition:background-color .15s ease,color .15s ease,border-color .15s ease}}"
    },
    {
      "name": "Champ",
      "kind": "input",
      "refersTo": "field",
      "description": "Saisie avec libellé explicite et aide liée au contrôle.",
      "html": "<label class=\"ds-field\"><span id=\"ds-travel-label\">Temps pour rejoindre la gare</span><input type=\"number\" value=\"8\" aria-labelledby=\"ds-travel-label\" aria-describedby=\"ds-travel-help\"><span class=\"ds-field-help\" id=\"ds-travel-help\">Les départs à moins de 8 minutes restent affichés, mais sont atténués.</span></label>",
      "css": ".ds-field{font-family:'Manrope Variable',sans-serif;display:flex;flex-direction:column;gap:8px;color:#465448;font-size:12px;line-height:1.5}.ds-field input{font:inherit;font-size:12px;min-height:40px;padding:11px 12px;border:1px solid #cbd2c7;border-radius:4px;background:#fffefa;color:#24352a;caret-color:var(--accent,#b94c23)}.ds-field input:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}.ds-field-help{font-size:11px;font-weight:400;line-height:1.7;color:var(--muted,#626d6a)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Navigation riche avec cibles de hauteur minimale 44px et page courante explicite.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigation\"><a href=\"#departures\" aria-current=\"page\">Départs</a><a href=\"#settings\">Réglages</a></nav>",
      "css": ".ds-nav{font-family:'Manrope Variable',sans-serif;display:flex;gap:28px;align-items:center}.ds-nav a{display:inline-flex;align-items:center;gap:4px;min-height:44px;font-size:13px;color:var(--muted,#626d6a);text-decoration:none}.ds-nav a[aria-current]{color:#202a2b;font-weight:800}.ds-nav a:hover{color:var(--accent,#b94c23)}.ds-nav a:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}"
    },
    {
      "name": "Carte d’édition",
      "kind": "card",
      "refersTo": "editor-card",
      "description": "Conteneur de configuration.",
      "html": "<section class=\"ds-card\"><h3>La Défense</h3><p>Ligne L · Paris Saint-Lazare</p></section>",
      "css": ".ds-card{font-family:'Manrope Variable',sans-serif;background:#fbfaf7;border:1px solid var(--line,#d9ded7);border-radius:8px;padding:24px;color:#202a2b}.ds-card h3{font-size:16px;font-weight:700;margin:0}.ds-card p{font-size:11px;color:var(--muted,#626d6a);margin:5px 0 0}"
    },
    {
      "name": "Badge de ligne",
      "kind": "chip",
      "refersTo": "line-badge",
      "description": "Identité de ligne aux couleurs officielles IDFM ; ardoise de repli sans couleur connue.",
      "html": "<span class=\"ds-line\" style=\"--line-color:#c4a4cc;--line-text-color:#000\">L</span> <span class=\"ds-line\">U</span>",
      "css": ".ds-line{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;min-width:30px;height:30px;padding:0 7px;border-radius:5px;background:var(--line-color,#595b64);color:var(--line-text-color,#fff);font-size:17px;font-weight:750;line-height:1}"
    },
    {
      "name": "Bloc épuré",
      "kind": "custom",
      "refersTo": "minimal-departure",
      "description": "Horaires monochromes passifs.",
      "html": "<section class=\"ds-minimal\"><div><span class=\"ds-minimal-line\">L</span><h2>La Défense</h2></div><p>Paris Saint-Lazare</p><table><tbody><tr><td class=\"ds-close\"><strong>3<small> min</small></strong><time>07:35</time></td><td><strong>12<small> min</small></strong><time>07:44</time></td><td><strong>22<small> min</small></strong><time>07:54</time></td></tr></tbody></table></section>",
      "css": ".ds-minimal{font:16px Arial,Helvetica,sans-serif;background:#fff;color:#000;padding:9px 0;border-bottom:1px solid #111}.ds-minimal-line{display:inline-block;padding:3px 8px;border:2px solid currentColor;font-size:1.35em;font-weight:700;line-height:1;vertical-align:middle}.ds-minimal h2{display:inline;font-size:1.45em;font-weight:700;margin:0 10px;vertical-align:middle}.ds-minimal p{margin:9px 0 12px;font-size:1.2em;line-height:1.3;white-space:nowrap}.ds-minimal table{width:100%;table-layout:fixed;border-collapse:collapse}.ds-minimal td{vertical-align:top;padding:2px 6px 0 0}.ds-minimal strong{display:block;font-size:2.7em;line-height:1.15;font-weight:700;white-space:nowrap}.ds-minimal small{font-size:.34em;font-weight:400}.ds-minimal time{display:block;font-size:1.15em;margin-top:7px}.ds-close{color:#737373}"
    },
    {
      "name": "Budget par API",
      "kind": "custom",
      "refersTo": "api-budget",
      "description": "Exemple de compteur local ; données illustratives, distinctes du compte PRIM.",
      "html": "<section class=\"ds-budget\" data-api=\"stop-monitoring\" data-level=\"normal\"><h3>Prochains passages · requête unitaire</h3><p class=\"ds-budget-value\">100<span> / 1 000</span></p><meter class=\"ds-budget-meter\" min=\"0\" max=\"1000\" value=\"100\" aria-label=\"Prochains passages · requête unitaire\">100 sur 1 000</meter><p class=\"ds-budget-consumption\"><strong>10 % utilisés</strong><span>900 restants</span></p><dl><div><dt>Estimation automatique / jour</dt><dd>218</dd></div><div><dt>Limite automatique / jour</dt><dd>900</dd></div></dl></section>",
      "css": ".ds-budget {\n  --budget-ink: var(--budget-passages-ink, #3f3974);\n  --budget-track: var(--budget-passages-track, #dcd7ed);\n  --budget-muted: var(--budget-passages-muted, #615b7a);\n  --budget-fill: var(--budget-ink);\n  margin-top: 20px;\n  padding: 18px 0 4px;\n  border-top: 2px solid var(--budget-ink);\n  color: var(--budget-ink);\n}\n.ds-budget[data-api='general-message'] {\n  --budget-ink: var(--budget-messages-ink, #275e70);\n  --budget-track: var(--budget-messages-track, #c6dce2);\n  --budget-muted: var(--budget-messages-muted, #446570);\n}\n.ds-budget[data-level='warning'] {\n  --budget-fill: var(--budget-warning, #8b4c13);\n}\n.ds-budget[data-level='critical'],\n.ds-budget[data-level='exhausted'] {\n  --budget-fill: var(--budget-critical, #a13f31);\n}\n.ds-budget h3 {\n  font-size: 13px;\n  line-height: 1.6;\n  margin: 0;\n}\n.ds-budget .ds-budget-value {\n  font-size: 38px;\n  color: var(--budget-ink);\n  font-weight: 650;\n  line-height: 1.2;\n  margin: 16px 0 4px;\n  font-variant-numeric: tabular-nums;\n}\n.ds-budget-value span {\n  font-size: 18px;\n  color: var(--budget-muted);\n  font-weight: 400;\n}\n.ds-budget-meter {\n  display: block;\n  appearance: none;\n  width: 100%;\n  height: 6px;\n  border: 0;\n  border-radius: 0;\n  background: var(--budget-track);\n  margin: 18px 0 10px;\n}\n.ds-budget-meter::-webkit-meter-bar {\n  height: 6px;\n  border: 0;\n  border-radius: 0;\n  background: var(--budget-track);\n}\n.ds-budget-meter::-webkit-meter-optimum-value {\n  background: var(--budget-fill);\n}\n.ds-budget-meter::-moz-meter-bar {\n  background: var(--budget-fill);\n}\n.ds-budget .ds-budget-consumption {\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 2px 12px;\n  color: var(--budget-muted);\n  font-size: 11px;\n  line-height: 1.6;\n  margin: 0;\n  font-variant-numeric: tabular-nums;\n}\n.ds-budget-consumption strong {\n  color: var(--budget-fill);\n  font-weight: 700;\n}\n.ds-budget dl {\n  border-top: 1px solid var(--budget-track);\n  padding-top: 16px;\n  margin-top: 16px;\n}\n.ds-budget dt {\n  color: var(--budget-muted);\n}\n.ds-budget dd {\n  color: var(--budget-ink);\n  font-variant-numeric: tabular-nums;\n}\n\n.ds-budget{font-family:'Manrope Variable',sans-serif}.ds-budget dl>div{display:flex;justify-content:space-between;gap:16px;margin-bottom:15px;font-size:11px}.ds-budget dd{margin:0;font-weight:600}.ds-budget .ds-budget-consumption{margin:0}"
    },
    {
      "name": "Avertissement de débordement",
      "kind": "custom",
      "description": "Alerte non bloquante avec détails repliables ; texte du bloc illustratif.",
      "html": "<div class=\"ds-layout-warning\"><svg class=\"ds-icon\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 4H4v16h10m4-16h2v3m0 10v3h-2M10 12h12m-3-3 3 3-3 3\"/></svg><div class=\"ds-layout-warning-content\"><strong>Risque de débordement sur la vue épurée</strong><p>Vous pouvez enregistrer. La partie hors écran restera inaccessible.</p><details class=\"ds-layout-warning-details\"><summary><svg class=\"ds-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m10 6 6 6-6 6\"/></svg>Voir les limites de cette disposition</summary><ul><li>Le bloc « Gare exemple · L » ne tient pas lisiblement dans l’écran épuré.</li></ul></details></div></div>",
      "css": ".ds-layout-warning {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  margin-bottom: 20px;\n  padding: 16px;\n  border: 1px solid #dfc9a9;\n  border-radius: 8px;\n  background: #f8f0e3;\n  color: #674b2c;\n  font-size: 12px;\n  line-height: 1.7;\n  overflow-wrap: anywhere;\n}\n.ds-layout-warning > .ds-icon {\n  margin-top: 1px;\n  color: var(--budget-warning);\n}\n.ds-layout-warning-content {\n  min-width: 0;\n}\n.ds-layout-warning strong {\n  display: block;\n  color: var(--budget-warning);\n  font-size: 14px;\n  line-height: 1.5;\n}\n.ds-layout-warning p {\n  margin: 6px 0 0;\n  max-width: 65ch;\n}\n.ds-layout-warning-details {\n  margin-top: 4px;\n}\n.ds-layout-warning-details summary {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: fit-content;\n  min-height: 44px;\n  padding: 8px 0;\n  cursor: pointer;\n  color: var(--budget-warning);\n  font-weight: 650;\n  list-style: none;\n}\n.ds-layout-warning-details summary::-webkit-details-marker {\n  display: none;\n}\n.ds-layout-warning-details summary:hover {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n.ds-layout-warning-details[open] summary .ds-icon {\n  transform: rotate(90deg);\n}\n.ds-layout-warning ul {\n  margin: 0;\n  padding: 12px 0 0 18px;\n  border-top: 1px solid #dfc9a9;\n  max-width: 65ch;\n}\n.ds-layout-warning li + li {\n  margin-top: 8px;\n}\n.ds-layout-warning{font-family:'Manrope Variable',sans-serif}.ds-layout-warning summary:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}"
    },
    {
      "name": "Information trafic",
      "kind": "custom",
      "description": "Diapositive de l’encart « Infos trafic » : signalement, badge, échéance visible sans défilement, puis titre et détail défilable.",

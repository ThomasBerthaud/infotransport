      "css": ".ds-primary{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;font-size:12px;font-weight:650;border-radius:5px;cursor:pointer;background:#284c39;color:#fff;border:1px solid #284c39}.ds-primary:hover:not(:disabled){background:#1a3728}.ds-primary:focus-visible{outline:3px solid var(--accent,#b94c23);outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color .15s ease,color .15s ease,border-color .15s ease}}"
